# Unity-generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity-generated IDE files
/*.csproj
/*.sln
/*.slnx
/*.unityproj
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# IDE and editor state
/.vs/
/.vscode/
/.idea/
__pycache__/
*.pyc
*.user
*.userprefs
*.suo
*.tmp

# Unity / OS transient files
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta
crashlytics-build.properties
/[Ee]xportedObj/
/.DS_Store
Thumbs.db
Desktop.ini
*.stackdump
*.asd
*.asd.meta

# Blender automatic backup files
*.blend[0-9]*

# Test and coverage output
/TestResults/
/CodeCoverage/

# Unity Test Framework leaves one of these in Assets/ for every PlayMode run
# that does not exit cleanly. They are never source.
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Rendered frames from the area capture fixture. Look at them, do not commit
# them: they are output, and they are large.
/Captures/

# Session diagnostics
/debug*.log
