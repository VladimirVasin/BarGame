* text=auto

# Keep source and configuration diffs stable across platforms.
*.cs text eol=lf diff=csharp
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.md text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.inputactions text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Configure UnityYAMLMerge as the `unityyamlmerge` driver in local Git config.
[attr]unity-yaml text eol=lf merge=unityyamlmerge
*.meta unity-yaml
*.unity unity-yaml
*.prefab unity-yaml
*.asset unity-yaml
*.mat unity-yaml
*.anim unity-yaml
*.controller unity-yaml
*.overrideController unity-yaml
*.physicMaterial unity-yaml
*.physicsMaterial2D unity-yaml

# Binary assets must never be line-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
*.dll binary

