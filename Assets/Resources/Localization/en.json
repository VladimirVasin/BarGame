      "key": "interaction.talk_fisherman",
      "value": "E — Talk to the fisherman"
    },
    {
      "key": "seacoast.fisherman.line.01",
      "value": "Not biting."
    },
    {
      "key": "seacoast.fisherman.line.02",
      "value": "It was biting this morning. Not now."
    },
    {
      "key": "seacoast.fisherman.line.03",
      "value": "Wind's changed. That's it till evening."
    },
    {
      "key": "seacoast.fisherman.line.04",
      "value": "Water's warm. So they're sitting deep."
    },
    {
      "key": "seacoast.fisherman.line.05",
      "value": "No whistling here."
    },
    {
      "key": "seacoast.fisherman.line.06",
      "value": "Counting the catch before you're done is bad."
    },
    {
      "key": "seacoast.fisherman.line.07",
      "value": "There'll be rain. By nightfall."
    },
    {
      "key": "seacoast.fisherman.line.08",
      "value": "There'll be no rain. I watched the clouds."
    },
    {
      "key": "seacoast.fisherman.line.09",
      "value": "No boats for hire. Ten years now."
    },
    {
      "key": "seacoast.fisherman.line.10",
      "value": "It's deep here. Three metres, by the boards."
    },
    {
      "key": "seacoast.fisherman.line.11",
      "value": "There used to be flounder. Now, I don't know."
    },
    {
      "key": "seacoast.fisherman.line.12",
      "value": "I always let the first one go. That's how it's done."
    },
    {
      "key": "seacoast.fisherman.line.13",
      "value": "The lamp doesn't help. Fish see light."
    },
    {
      "key": "seacoast.fisherman.line.14",
      "value": "Quiet. Good that it's quiet."
    },
    {
      "key": "seacoast.fisherman.line.15",
      "value": "Home soon. I'll sit a while longer."
    },
    {
      "key": "interaction.ferryman",
      "value": "E — Talk to the ferryman"
    },
    {
      "key": "lastroute.ferryman.confirm.leave",
      "value": "Leave the city?"
    },
    {
      "key": "lastroute.ferryman.line.01",
      "value": "Early."
    },
    {
      "key": "lastroute.ferryman.line.02",
      "value": "The route was cancelled. I wait anyway."
    },
    {
      "key": "lastroute.ferryman.line.03",
      "value": "There is petrol. There is no reason."
    },
    {
      "key": "lastroute.ferryman.line.04",
      "value": "Not today."
    },
    {
      "key": "lastroute.ferryman.line.05",
      "value": "Twenty years on this run. Always the same place."
    },
    {
      "key": "lastroute.ferryman.line.06",
      "value": "One headlight is gone. It still drives."
    },
    {
      "key": "lastroute.ferryman.line.07",
      "value": "The last route has already gone. Or it has not yet."
    },
    {
      "key": "lastroute.ferryman.line.08",
      "value": "The timetable is on the board. It lies."
    },
    {
      "key": "lastroute.ferryman.line.09",
      "value": "I flip a coin. The answer never changes."
    },
    {
      "key": "lastroute.ferryman.line.10",
      "value": "I am waiting. Not for you."
    },
    {
      "key": "lastroute.ferryman.line.11",
      "value": "You have not got it on you. I would have noticed."
    },
    {
      "key": "lastroute.ferryman.line.12",
      "value": "Nobody gets driven back this way."
    },
    {
      "key": "park.quarrel.chess.line.01",
      "value": "In draughts they think with the knee."
    },
    {
      "key": "park.quarrel.chess.line.02",
      "value": "A draught goes forward. Back would shame it."
    },
    {
      "key": "park.quarrel.chess.line.03",
      "value": "That is no game. You shuffle bottle caps."
    },
    {
      "key": "park.quarrel.chess.line.04",
      "value": "Draughts is chess with the thought taken out."
    },
    {
      "key": "park.quarrel.chess.line.05",
      "value": "A king there is a pawn promoted for service."
    },
    {
      "key": "park.quarrel.chess.line.06",
      "value": "Your whole thought fits on one diagonal."
    },
    {
      "key": "park.quarrel.chess.line.07",
      "value": "Thirty-two squares, and all of them missed."
    },
    {
      "key": "park.quarrel.chess.line.08",
      "value": "Takes three in a row and glows like a stove."
    },
    {
      "key": "park.quarrel.chess.line.09",
      "value": "Your king is two draughts stacked up."
    },
    {
      "key": "park.quarrel.chess.line.10",
      "value": "No mate in draughts. So nothing to discuss."
    },
    {
      "key": "park.quarrel.chess.line.11",
      "value": "A game for men who cannot tell pieces apart."
    },
    {
      "key": "park.quarrel.chess.line.12",
      "value": "You are not playing. You are sweeping."
    },
    {
      "key": "park.quarrel.checkers.line.01",
      "value": "The knight moves like a letter. A sad one."
    },
    {
      "key": "park.quarrel.checkers.line.02",
      "value": "Two hours of thinking to lose in a minute."
    },
    {
      "key": "park.quarrel.checkers.line.03",
      "value": "A bishop on one colour for life. Like you."
    },
    {
      "key": "park.quarrel.checkers.line.04",
      "value": "Castling is a king running round a corner."
    },
    {
      "key": "park.quarrel.checkers.line.05",
      "value": "Sixteen pieces and not one idea in them."
    },
    {
      "key": "park.quarrel.checkers.line.06",
      "value": "You have no game. You have social classes."
    },
    {
      "key": "park.quarrel.checkers.line.07",
      "value": "The queen works, the rest stand. Familiar?"
    },
    {
      "key": "park.quarrel.checkers.line.08",
      "value": "You do not play. You recite other men."
    },
    {
      "key": "park.quarrel.checkers.line.09",
      "value": "En passant. The name alone says enough."
    },
    {
      "key": "park.quarrel.checkers.line.10",
      "value": "Chess was invented to keep silent nicely."
    },
    {
      "key": "park.quarrel.checkers.line.11",
      "value": "Your game ends in a draw. Like the rest."
    },
    {
      "key": "park.quarrel.checkers.line.12",
      "value": "More rules than players at this table."
    },
    {
      "key": "park.board.chess.greet.01",
      "value": "At last. Sit, do not hover."
    },
    {
      "key": "park.board.chess.greet.02",
      "value": "I have White. Do not dawdle."
    },
    {
      "key": "park.board.chess.take.01",
      "value": "A piece was there. Now it is not."
    },
    {
      "key": "park.board.chess.take.02",
      "value": "Thank you. I will take that."
    },
    {
      "key": "park.board.chess.win.01",
      "value": "Mate. As always."
    },
    {
      "key": "park.board.chess.win.02",
      "value": "That is the game."
    },
    {
      "key": "park.board.chess.lose.01",
      "value": "Hm. Fine. It happens."
    },
    {
      "key": "park.board.chess.lose.02",
      "value": "You won. A fluke."
    },
    {
      "key": "park.board.checkers.greet.01",
      "value": "So the fourth stool was good for something."
    },
    {
      "key": "park.board.checkers.greet.02",
      "value": "Taking is compulsory, remember?"
    },
    {
      "key": "park.board.checkers.take.01",
      "value": "Eaten. And I will eat again."
    },
    {
      "key": "park.board.checkers.take.02",
      "value": "Do not offer them. I will take."
    },
    {
      "key": "park.board.checkers.win.01",
      "value": "So much for your strategy."
    },
    {
      "key": "park.board.checkers.win.02",
      "value": "Nothing left to move. Game."
    },
    {
      "key": "park.board.checkers.lose.01",
      "value": "Luck. Once."
    },
    {
      "key": "park.board.checkers.lose.02",
      "value": "Swept me. Well I never."
    },
    {
      "key": "park.board.chess.yourmove.01",
      "value": "Move. I can wait."
    },
    {
      "key": "park.board.chess.yourmove.02",
      "value": "Your move. Not all day."
    },
    {
      "key": "park.board.chess.check.01",
      "value": "Check. Look properly."
    },
    {
      "key": "park.board.chess.check.02",
      "value": "Check. Your king is crowded."
    },
    {
      "key": "park.board.chess.crown.01",
      "value": "The pawn got there. A queen now."
    },
    {
      "key": "park.board.chess.crown.02",
      "value": "A queen. Out of a pawn, mind."
    },
    {
      "key": "park.board.chess.musttake.01",
      "value": "That one is going nowhere."
    },
    {
      "key": "park.board.chess.musttake.02",
      "value": "Not that piece. Think."
    },
    {
      "key": "park.board.chess.draw.01",
      "value": "A draw. Dull."
    },
    {
      "key": "park.board.chess.draw.02",
      "value": "Nobody beat anybody. Usual."
    },
    {
      "key": "park.board.chess.again.01",
      "value": "Another? Press R."
    },
    {
      "key": "park.board.chess.again.02",
      "value": "Set it up again — R."
    },
    {
      "key": "park.board.checkers.yourmove.01",
      "value": "Your move. Get on."
    },
    {
      "key": "park.board.checkers.yourmove.02",
      "value": "Well? Do not dawdle."
    },
    {
      "key": "park.board.checkers.crown.01",
      "value": "A king. Now hold on."
    },
    {
      "key": "park.board.checkers.crown.02",
      "value": "Crowned. Start counting."
    },
    {
      "key": "park.board.checkers.musttake.01",
      "value": "Taking is compulsory. Look."
    },
    {
      "key": "park.board.checkers.musttake.02",
      "value": "Not that one. There is a take."
    },
    {
      "key": "park.board.checkers.draw.01",
      "value": "A draw. Shuffling."
    },
    {
      "key": "park.board.checkers.draw.02",
      "value": "Nobody ate anybody."
    },
    {
      "key": "park.board.checkers.again.01",
      "value": "Again? Press R."
    },
    {
      "key": "park.board.checkers.again.02",
      "value": "Set them up — R."
    },
