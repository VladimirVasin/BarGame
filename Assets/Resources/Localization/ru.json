    {
      "key": "interaction.talk_fisherman",
      "value": "E — заговорить с рыбаком"
    },
    {
      "key": "seacoast.fisherman.line.01",
      "value": "Не клюёт."
    },
    {
      "key": "seacoast.fisherman.line.02",
      "value": "С утра клевало. Теперь — нет."
    },
    {
      "key": "seacoast.fisherman.line.03",
      "value": "Ветер сменился. Всё, до вечера."
    },
    {
      "key": "seacoast.fisherman.line.04",
      "value": "Вода тёплая. Значит, стоит внизу."
    },
    {
      "key": "seacoast.fisherman.line.05",
      "value": "Свистеть тут не надо."
    },
    {
      "key": "seacoast.fisherman.line.06",
      "value": "Считать улов до конца — плохо."
    },
    {
      "key": "seacoast.fisherman.line.07",
      "value": "Дождь будет. К ночи."
    },
    {
      "key": "seacoast.fisherman.line.08",
      "value": "Дождя не будет. Я на облака смотрел."
    },
    {
      "key": "seacoast.fisherman.line.09",
      "value": "Лодки не дают. Уже лет десять как."
    },
    {
      "key": "seacoast.fisherman.line.10",
      "value": "Тут глубоко. Метра три, если у мостков."
    },
    {
      "key": "seacoast.fisherman.line.11",
      "value": "Раньше камбала была. Сейчас — не знаю."
    },
    {
      "key": "seacoast.fisherman.line.12",
      "value": "Первую всегда отпускаю. Так надо."
    },
    {
      "key": "seacoast.fisherman.line.13",
      "value": "Фонарь мешает. Рыба свет видит."
    },
    {
      "key": "seacoast.fisherman.line.14",
      "value": "Тихо. Хорошо, что тихо."
    },
    {
      "key": "seacoast.fisherman.line.15",
      "value": "Скоро домой. Ещё немного посижу."
    },
    {
      "key": "interaction.ferryman",
      "value": "E — заговорить с перевозчиком"
    },
    {
      "key": "lastroute.ferryman.confirm.leave",
      "value": "Уехать из города?"
    },
    {
      "key": "lastroute.ferryman.line.01",
      "value": "Рано."
    },
    {
      "key": "lastroute.ferryman.line.02",
      "value": "Маршрут отменили. Я всё равно жду."
    },
    {
      "key": "lastroute.ferryman.line.03",
      "value": "Бензин есть. Повода нет."
    },
    {
      "key": "lastroute.ferryman.line.04",
      "value": "Не сегодня."
    },
    {
      "key": "lastroute.ferryman.line.05",
      "value": "Двадцать лет вожу. Всё туда же."
    },
    {
      "key": "lastroute.ferryman.line.06",
      "value": "Фара разбита. Ехать-то можно."
    },
    {
      "key": "lastroute.ferryman.line.07",
      "value": "Последний рейс уже был. Или ещё будет."
    },
    {
      "key": "lastroute.ferryman.line.08",
      "value": "Расписание на щите. Оно врёт."
    },
    {
      "key": "lastroute.ferryman.line.09",
      "value": "Монетку подбрасываю. Ответ всегда один."
    },
    {
      "key": "lastroute.ferryman.line.10",
      "value": "Жду. Не тебя."
    },
    {
      "key": "lastroute.ferryman.line.11",
      "value": "У тебя не с собой. Я бы заметил."
    },
    {
      "key": "lastroute.ferryman.line.12",
      "value": "Обратно этой дорогой не возят."
    },
    {
      "key": "lastroute.ferryman.mountain.line.01",
      "value": "Приехали."
    },
    {
      "key": "lastroute.ferryman.mountain.line.02",
      "value": "Дальше не везу. Дороги нет."
    },
    {
      "key": "lastroute.ferryman.mountain.line.03",
      "value": "Двадцать лет сюда. Первый раз не один."
    },
    {
      "key": "lastroute.ferryman.mountain.line.04",
      "value": "Мотор остынет — и всё."
    },
    {
      "key": "lastroute.ferryman.mountain.line.05",
      "value": "Холодно тут. Всегда было."
    },
    {
      "key": "lastroute.ferryman.mountain.line.06",
      "value": "Машина дошла. Не каждый раз доходит."
    },
    {
      "key": "lastroute.ferryman.mountain.line.07",
      "value": "Я подожду. Мне не привыкать."
    },
    {
      "key": "lastroute.ferryman.mountain.line.08",
      "value": "Монетка осталась. Бросать некуда."
    },
    {
      "key": "lastroute.ferryman.mountain.line.09",
      "value": "Ты добрался. Это уже редкость."
